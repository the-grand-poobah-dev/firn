# Supabase project credentials. The service-role key is server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=https://firn-topaz.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte random bearer secret for authenticated cron requests.
CRON_SECRET=
# Public support contact shown in the app.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Preview only: demo login is enabled only when NEXT_PUBLIC_DEMO=1 and NODE_ENV is not production.
NEXT_PUBLIC_DEMO=0
# Preview only; never expose this value to the browser.
DEMO_PASSWORD=
